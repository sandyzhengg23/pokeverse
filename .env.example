# Copy to .env.local for local development. Never commit real values.

# Meta Model API key (server-side only; no NEXT_PUBLIC_ prefix).
MODEL_API_KEY=

# Shared rate-limit store for /api/scan and /api/journey (recommended for production).
# Create a free Upstash Redis database (or add the Upstash integration in the Vercel
# Marketplace, which sets the KV_REST_API_* names automatically). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# App-wide cap on Meta AI requests per UTC day, shared by ALL visitors and BOTH features
# (card scans + journeys). Counted in Redis, resets at 00:00 UTC. Unset = 500. 0 = AI disabled.
# An invalid value disables AI rather than guessing. In production, if Redis is missing or
# unreachable, AI requests are rejected (503) instead of running unmetered.
AI_DAILY_CALL_LIMIT=20
