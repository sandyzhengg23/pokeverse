# Copy to .env.local for local development. Never commit real values.

# Meta Model API key (server-side only; no NEXT_PUBLIC_ prefix).
MODEL_API_KEY=

# Shared rate-limit store for /api/scan and /api/journey (recommended for production).
# Create a free Upstash Redis database (or add the Upstash integration in the Vercel
# Marketplace, which sets the KV_REST_API_* names automatically). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: global cap on AI calls per UTC day across all visitors (default 500).
AI_DAILY_CALL_LIMIT=
